# Modelo de variables de entorno. Copialo como .env.local y completalo.
# .env.local no se sube a git (ver .gitignore). En Netlify se cargan las mismas
# en Site configuration → Environment variables (menos ADMIN_*, que solo usa el script).

# Configuración web de Firebase (Consola → Configuración del proyecto → Tus apps).
# Llevan VITE_ porque las usa el navegador: no son secretas, lo que protege los datos
# son las reglas de Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API key de https://api.imgbb.com/ para subir las imágenes de productos.
# SIN VITE_: la usa solo el servidor (Netlify Function o npm run dev), nunca llega al navegador.
IMGBB_KEY=

# Cuenta admin de Firebase Auth. Solo la usa `npm run cargar-datos` para la carga inicial.
ADMIN_EMAIL=
ADMIN_PASSWORD=
