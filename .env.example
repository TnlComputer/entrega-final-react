# Modelo de variables de entorno. Copialo como .env.local y completalo.
# .env.local no se sube a git (ver .gitignore).

# Usuario del panel admin (npm run dev). SIN prefijo VITE_: nunca llegan al navegador.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API key de https://api.imgbb.com/ para subir las imágenes de productos.
# También SIN VITE_: la usa solo el servidor de desarrollo.
IMGBB_KEY=
