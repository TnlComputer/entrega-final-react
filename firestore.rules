rules_version = '2';

// Lee cualquiera, escriben solo los admins (documento admins/{uid})
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /rubros/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /imagenes/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Cada uno solo ve su propio documento
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
